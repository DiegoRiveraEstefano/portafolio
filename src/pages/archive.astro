---
// Redirección técnica hacia el catálogo consolidado /projects
const basePath = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${basePath}/projects`} />
    <title>Redirigiendo al Catálogo de Proyectos...</title>
    <link rel="canonical" href={`${basePath}/projects`} />
  </head>
  <body style="background-color: #111; color: #eee; font-family: monospace; padding: 2rem;">
    <p>[SYS_REDIRECT] // Redirigiendo a /projects...</p>
    <p>Si no eres redirigido automáticamente, <a href={`${basePath}/projects`} style="color: #f59e0b;">haz clic aquí para ir al Catálogo de Proyectos</a>.</p>
  </body>
</html>
