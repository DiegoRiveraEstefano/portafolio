---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const basePath = import.meta.env.BASE_URL;
const galleryImages =
    project.data.images && project.data.images.length > 0
        ? project.data.images
        : project.data.image
          ? [{ src: project.data.image, caption: project.data.title }]
          : [];
const resolveImgSrc = (src: string) =>
    src.startsWith("/") ? `${basePath}${src.slice(1)}` : src;
---

<Layout
    title={`${project.data.title} // Especificación Técnica | Diego Rivera`}
>
    <Navigation />

    <main class="project-detail-main">
        <div class="container">
            <!-- Breadcrumb Bar -->
            <nav
                class="breadcrumb-bar mono text-xs text-muted"
                aria-label="Ruta de navegación"
            >
                <a href={`${basePath}`} class="crumb-link">
                    00 // INICIO
                </a>
                <span class="crumb-sep">/</span>
                <a href={`${basePath}projects`} class="crumb-link">
                    03 // CATÁLOGO
                </a>
                <span class="crumb-sep">/</span>
                <span class="crumb-current text-amber">
                    [PRJ_SPEC: {project.id}]
                </span>
            </nav>

            <!-- Project Detail Chassis -->
            <article class="detail-chassis specs-card corner-marks">
                <!-- Chassis Header Bar -->
                <div class="detail-header-bar">
                    <div class="header-status">
                        <span
                            class={`status-dot status-dot--${project.data.archived ? "amber" : "green"}`}
                        ></span>
                        <span class="mono text-2xs">
                            STATUS:{" "}
                            {project.data.archived
                                ? "ARCHIVED_PRESERVED"
                                : "PRODUCTION_ACTIVE"}
                        </span>
                    </div>
                    <div class="header-date mono text-2xs text-muted">
                        REG_DATE: {project.data.date}
                    </div>
                </div>

                <!-- Project Hero Header -->
                <header class="project-meta-hero">
                    <span class="meta-serial mono text-xs text-amber">
                        // TECHNICAL_SPECIFICATION_SHEET
                    </span>
                    <h1 class="project-headline">{project.data.title}</h1>
                    <p class="project-lead">{project.data.description}</p>

                    <!-- Action Switchboard -->
                    <div class="project-switchboard">
                        {project.data.link && (
                            <a
                                href={project.data.link}
                                class="btn btn-primary"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span>ABRIR REPOSITORIO / ENLACE</span>
                                <span class="mono">↗</span>
                            </a>
                        )}
                        <a
                            href={`${basePath}projects`}
                            class="btn btn-secondary"
                        >
                            <span class="mono">←</span>
                            <span>VOLVER AL CATÁLOGO</span>
                        </a>
                    </div>
                </header>

                <!-- Technical Telemetry & Specs Strip -->
                <div class="specs-dashboard">
                    <div class="dashboard-block">
                        <span class="dash-label mono text-2xs text-muted">
                            [STACK_TECNOLÓGICO]
                        </span>
                        <div class="tech-badges">
                            {project.data.technologies.map((tech) => (
                                <span class="badge">{tech}</span>
                            ))}
                        </div>
                    </div>

                    <div class="dashboard-block">
                        <span class="dash-label mono text-2xs text-muted">
                            [DOMINIO_Y_TAGS]
                        </span>
                        <div class="tech-badges">
                            {project.data.tags.map((tag) => (
                                <span class="badge badge--cyan">{tag}</span>
                            ))}
                        </div>
                    </div>

                    {project.data.results &&
                        project.data.results.length > 0 && (
                            <div class="dashboard-block full-width">
                                <span class="dash-label mono text-2xs text-muted">
                                    [RESULTADOS_CLAVE_VERIFICADOS]
                                </span>
                                <ul class="results-list">
                                    {project.data.results.map((res) => (
                                        <li class="result-item">
                                            <span class="res-check mono text-phosphor">
                                                [OK]
                                            </span>
                                            <span>{res}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                </div>

                {galleryImages.length > 0 && (
                    <section
                        class="gallery-section"
                        aria-label="Capturas del sistema"
                    >
                        <div class="gallery-header">
                            <span class="dash-label mono text-2xs text-muted">
                                [CAPTURAS_DE_INTERFAZ // VISUAL_TELEMETRY]
                            </span>
                            <span class="mono text-2xs text-amber">
                                {galleryImages.length}{" "}
                                {galleryImages.length === 1
                                    ? "CAPTURA"
                                    : "CAPTURAS"}
                            </span>
                        </div>
                        <div class="gallery-grid">
                            {galleryImages.map((item, idx) => {
                                const imgUrl = resolveImgSrc(item.src);
                                return (
                                    <figure class="gallery-card">
                                        <button
                                            type="button"
                                            class="gallery-thumb-btn"
                                            data-lightbox-src={imgUrl}
                                            data-lightbox-caption={item.caption}
                                            aria-label={`Ampliar captura: ${item.caption}`}
                                        >
                                            <picture class="gallery-picture">
                                                <source
                                                    srcset={imgUrl.replace(/\.png$/i, ".avif")}
                                                    type="image/avif"
                                                />
                                                <img
                                                    src={imgUrl}
                                                    alt={item.caption}
                                                    class="gallery-img"
                                                    loading="lazy"
                                                />
                                            </picture>
                                            <span class="gallery-zoom-tag mono text-2xs">
                                                [IMG_{String(idx + 1).padStart(2, "0")}] ↗
                                            </span>
                                        </button>
                                        <figcaption class="gallery-caption">
                                            {item.caption}
                                        </figcaption>
                                    </figure>
                                );
                            })}
                        </div>
                    </section>
                )}

                <!-- Markdown Rendered Technical Body -->
                <div class="markdown-body">
                    <Content />
                </div>

                <!-- Detail Footer -->
                <footer class="detail-footer">
                    <span class="mono text-2xs text-muted">
                        SPEC_ID: {project.id} // DOCUMENT_INTEGRITY: VERIFIED
                    </span>
                    <a
                        href={`${basePath}projects`}
                        class="btn btn-ghost btn-sm"
                    >
                        <span>EXPLORAR MÁS PROYECTOS</span>
                        <span class="mono">→</span>
                    </a>
                </footer>
            </article>
        </div>
    </main>

    <dialog id="image-lightbox" class="image-lightbox">
        <div class="lightbox-frame specs-card">
            <div class="lightbox-bar">
                <span id="lightbox-caption" class="mono text-xs text-muted"></span>
                <button
                    type="button"
                    id="lightbox-close"
                    class="btn btn-secondary btn-sm mono"
                    aria-label="Cerrar vista previa"
                >
                    [ESC // CERRAR]
                </button>
            </div>
            <div class="lightbox-media">
                <picture style="display: contents;">
                    <source id="lightbox-avif" srcset="" type="image/avif" />
                    <img id="lightbox-img" src="" alt="" />
                </picture>
            </div>
        </div>
    </dialog>

    <Footer />
</Layout>

<script>
    const dialog = document.getElementById("image-lightbox") as HTMLDialogElement | null;
    const dialogImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const dialogAvif = document.getElementById("lightbox-avif") as HTMLSourceElement | null;
    const dialogCaption = document.getElementById("lightbox-caption");
    const closeBtn = document.getElementById("lightbox-close");

    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach((btn) => {
        btn.addEventListener("click", () => {
            if (!dialog || !dialogImg || !dialogCaption) return;
            const src = btn.dataset.lightboxSrc || "";
            const caption = btn.dataset.lightboxCaption || "";
            if (dialogAvif) {
                dialogAvif.srcset = src.replace(/\.png$/i, ".avif");
            }
            dialogImg.src = src;
            dialogImg.alt = caption;
            dialogCaption.textContent = caption;
            dialog.showModal();
        });
    });

    closeBtn?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
    });
</script>

<style>
    .project-detail-main {
        padding-top: calc(4.25rem + var(--space-6));
        padding-bottom: var(--space-20);
        min-height: 85vh;
    }

    /* Breadcrumb */
    .breadcrumb-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-6);
    }

    .crumb-link {
        transition: color var(--transition-fast);

        &:hover {
            color: var(--color-text);
        }
    }

    .crumb-sep {
        color: var(--color-border-strong);
    }

    /* Detail Chassis */
    .detail-chassis {
        padding: 0;
        overflow: hidden;
        box-shadow: var(--shadow-elevation);
        background-color: var(--color-surface);
    }

    .detail-header-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3) var(--space-6);
        background-color: var(--color-surface-sunken);
        border-bottom: 1px solid var(--color-border);
        gap: var(--space-2);
    }

    .header-status {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text);
    }

    /* Meta Hero */
    .project-meta-hero {
        padding: clamp(var(--space-6), 5vw, var(--space-10));
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .meta-serial {
        letter-spacing: 0.08em;
    }

    .project-headline {
        font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.15;
    }

    .project-lead {
        font-size: clamp(var(--text-base), 2vw, var(--text-lg));
        color: var(--color-text-muted);
        max-width: 65ch;
    }

    .project-switchboard {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-top: var(--space-4);
    }

    /* Specs Dashboard */
    .specs-dashboard {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
        padding: var(--space-6) clamp(var(--space-6), 5vw, var(--space-10));
        background-color: var(--color-surface-sunken);
        border-bottom: 1px solid var(--color-border);

        @media (min-width: 768px) {
            grid-template-columns: 1fr 1fr;
        }
    }

    .dashboard-block {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);

        &.full-width {
            grid-column: 1 / -1;
        }
    }

    .dash-label {
        letter-spacing: 0.06em;
    }

    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }

    .results-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-top: var(--space-1);
    }

    .result-item {
        display: flex;
        align-items: flex-start;
        gap: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-text);
    }

    /* Markdown Body Styling */
    .markdown-body {
        padding: clamp(var(--space-6), 5vw, var(--space-10));
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
        color: var(--color-text);
        font-size: var(--text-base);
        line-height: 1.7;

        h2 {
            font-size: var(--text-2xl);
            margin-top: var(--space-6);
            padding-bottom: var(--space-2);
            border-bottom: 1px solid var(--color-border-subtle);
            color: var(--color-text);
            display: flex;
            align-items: center;
            gap: var(--space-2);

            &::before {
                content: "##";
                font-family: var(--font-mono);
                font-size: 0.7em;
                color: var(--color-amber-text);
            }
        }

        h3 {
            font-size: var(--text-xl);
            margin-top: var(--space-4);
            color: var(--color-text);
        }

        p {
            color: var(--color-text-muted);
        }

        ul,
        ol {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            padding-left: var(--space-6);
            list-style-type: square;
            color: var(--color-text-muted);
        }

        strong {
            color: var(--color-text);
            font-weight: 600;
        }

        code:not(pre code) {
            font-family: var(--font-mono);
            font-size: 0.88em;
            padding: 2px 6px;
            background-color: var(--color-surface-elevated);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-xs);
            color: var(--color-text);
        }

        pre {
            background-color: var(--color-surface-sunken);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-xs);
            padding: var(--space-4);
            overflow-x: auto;
            font-family: var(--font-mono);
            font-size: var(--text-xs);
            line-height: 1.5;
        }
    }

    /* Detail Footer */
    .detail-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3) clamp(var(--space-6), 5vw, var(--space-10));
        background-color: var(--color-surface-sunken);
        border-top: 1px solid var(--color-border);
        gap: var(--space-2);
    }

    /* Gallery Section */
    .gallery-section {
        padding: var(--space-6) clamp(var(--space-6), 5vw, var(--space-10));
        border-bottom: 1px solid var(--color-border);
        background-color: var(--color-surface);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .gallery-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: var(--space-4);
    }

    .gallery-card {
        display: flex;
        flex-direction: column;
        background-color: var(--color-surface-sunken);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xs);
        overflow: hidden;
        transition:
            border-color var(--transition-fast),
            transform var(--transition-fast);

        &:hover {
            border-color: var(--color-amber);
            transform: translateY(-2px);
        }
    }

    .gallery-thumb-btn {
        position: relative;
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        padding: 0;
        border: none;
        background: var(--color-surface-elevated);
        cursor: zoom-in;
        overflow: hidden;
    }

    .gallery-picture {
        display: contents;
    }

    .gallery-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform var(--transition-base);
    }

    .gallery-card:hover .gallery-img {
        transform: scale(1.03);
    }

    .gallery-zoom-tag {
        position: absolute;
        bottom: var(--space-2);
        right: var(--space-2);
        padding: 2px 6px;
        background-color: color-mix(in oklch, var(--color-surface-sunken) 88%, transparent);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xs);
        color: var(--color-amber-text);
    }

    .gallery-caption {
        padding: var(--space-3);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        line-height: 1.45;
        border-top: 1px solid var(--color-border-subtle);
    }

    /* Lightbox */
    .image-lightbox {
        max-width: min(92vw, 1100px);
        width: 100%;
        margin: auto;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--color-text);

        &::backdrop {
            background-color: rgba(0, 0, 0, 0.82);
            backdrop-filter: blur(4px);
        }
    }

    .lightbox-frame {
        padding: 0;
        overflow: hidden;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border-strong);
    }

    .lightbox-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        background-color: var(--color-surface-sunken);
        border-bottom: 1px solid var(--color-border);
    }

    .lightbox-media {
        padding: var(--space-3);
        background-color: var(--color-surface-sunken);
        display: flex;
        justify-content: center;

        img {
            max-height: 78vh;
            width: auto;
            max-width: 100%;
            object-fit: contain;
            border-radius: var(--radius-xs);
        }
    }

    .btn-sm {
        padding: var(--space-2) var(--space-3);
        font-size: var(--text-2xs);
    }
</style>
