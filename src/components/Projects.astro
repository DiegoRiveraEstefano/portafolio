---
import { getCollection } from "astro:content";

const basePath = import.meta.env.BASE_URL;
// Proyectos seleccionados para la página principal ordenados por fecha
const projectCollection = await getCollection("projects");
const activeProjects = projectCollection
    .filter((p) => p.data.showOnHome && !p.data.archived)
    .sort((a, b) => b.data.date.localeCompare(a.data.date));

// Iconos e indicadores técnicos por categoría de proyecto
const projectVisuals: Record<
    string,
    { code: string; accent: string; svg: string }
> = {
    MockHavoc: {
        code: "SYS_CHAOS_PROXY",
        accent: "accent-coral",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`,
    },
    LedgerFlow: {
        code: "SYS_FINTECH_ACID",
        accent: "accent-phosphor",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`,
    },
    NanoStock: {
        code: "SYS_ERP_MODULITH",
        accent: "accent-amber",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>`,
    },
    "Go-Refinery": {
        code: "SYS_ETL_STREAM",
        accent: "accent-cyan",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>`,
    },
    "Uptime-Monitor": {
        code: "SYS_OTP_MONITOR",
        accent: "accent-purple",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>`,
    },
    "JTE Zed Extension": {
        code: "SYS_LSP_GRAMMAR",
        accent: "accent-amber",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>`,
    },
    "360° Virtual Tour Demo": {
        code: "SYS_WEBGL_360",
        accent: "accent-cyan",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>`,
    },
    "Sistema de Control HID & Coprocesamiento IoT": {
        code: "SYS_HID_IOT",
        accent: "accent-amber",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>`,
    },
    "Brújula Digital Profesional": {
        code: "SYS_EDTECH",
        accent: "accent-phosphor",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>`,
    },
    "Clasificador de Tickets con ML": {
        code: "SYS_ML_NLP",
        accent: "accent-cyan",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
    },
    "Arquitectura de Servicios con Kafka y Go": {
        code: "SYS_GATEWAY",
        accent: "accent-coral",
        svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path></svg>`,
    },
};
---

<section id="projects" class="section projects-section">
    <div class="container">
        <div class="section-header">
            <span class="section-index">03 // SISTEMAS &amp; ARTEFACTOS</span>
            <h2 class="section-title">Proyectos Destacados</h2>
            <p class="section-subtitle">
                Arquitecturas backend, implementaciones de machine learning y
                herramientas de desarrollo construidas para producción.
            </p>
        </div>

        <!-- Projects Grid Container -->
        <div class="projects-grid">
            {activeProjects.map((project, index) => {
                const serialNum = String(index + 1).padStart(2, "0");
                const visual = projectVisuals[project.data.title] || {
                    code: "SYS_CORE",
                    accent: "accent-amber",
                    svg: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"></path></svg>`,
                };

                return (
                    <article
                        class={`project-card ${visual.accent} specs-card corner-marks`}
                    >
                        <!-- Project Technical Header -->
                        <div class="project-header">
                            <div class="project-ident">
                                <span class="project-serial mono text-amber">
                                    [PRJ_{serialNum}]
                                </span>
                                <span class="project-subcode mono text-2xs text-muted">
                                    {visual.code}
                                </span>
                            </div>
                            <div class="project-date mono text-2xs text-muted">
                                {project.data.date}
                            </div>
                        </div>

                        <!-- Project Schematic Visual / Screen -->
                        <div class="project-screen">
                            {project.data.image ? (
                                <>
                                    <picture class="screen-picture">
                                        <source
                                            srcset={(project.data.image.startsWith("/")
                                                ? `${basePath}${project.data.image.slice(1)}`
                                                : project.data.image
                                            ).replace(/\.png$/i, ".avif")}
                                            type="image/avif"
                                        />
                                        <img
                                            src={
                                                project.data.image.startsWith("/")
                                                    ? `${basePath}${project.data.image.slice(1)}`
                                                    : project.data.image
                                            }
                                            alt={`Vista previa de ${project.data.title}`}
                                            class="screen-image"
                                            loading="lazy"
                                        />
                                    </picture>
                                    <div class="screen-indicator screen-indicator--badge mono text-2xs">
                                        <span>STATUS: PRODUCTION</span>
                                    </div>
                                </>
                            ) : (
                                <>
                                    <div
                                        class="screen-grid-bg"
                                        aria-hidden="true"
                                    ></div>
                                    <div class="screen-icon">
                                        <Fragment set:html={visual.svg} />
                                    </div>
                                    <div class="screen-indicator mono text-2xs">
                                        <span>STATUS: PRODUCTION</span>
                                    </div>
                                </>
                            )}
                        </div>

                        <!-- Project Details -->
                        <div class="project-content">
                            <h3 class="project-title">{project.data.title}</h3>
                            <p class="project-desc">
                                {project.data.description}
                            </p>

                            <!-- Tech Badges -->
                            <div class="project-tech-list">
                                {project.data.technologies.map((tech) => (
                                    <span class="badge">{tech}</span>
                                ))}
                            </div>

                            <!-- Action Footer -->
                            <div class="project-actions">
                                <a
                                    href={`${basePath}projects/${project.id}`}
                                    class="btn btn-primary btn-sm"
                                >
                                    <span>VER DETALLE TÉCNICO</span>
                                    <span class="mono">→</span>
                                </a>

                                <a
                                    href={project.data.link}
                                    class="btn btn-ghost btn-sm btn-icon"
                                    aria-label="Ver repositorio en GitHub"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <svg
                                        class="gh-icon"
                                        fill="currentColor"
                                        viewBox="0 0 20 20"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                );
            })}
        </div>

        <!-- Catalog Callout Panel -->
        <div class="archive-callout">
            <div class="archive-meta mono text-xs text-muted">
                <span>CATALOG_INDEX: COMPLETE_PROJECTS_REGISTRY</span>
            </div>
            <a href={`${basePath}projects`} class="btn btn-secondary">
                <span>
                    EXPLORAR CATÁLOGO COMPLETO ({projectCollection.length})
                </span>
                <span class="mono">→</span>
            </a>
        </div>
    </div>
</section>

<style>
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: var(--space-8);
    }

    .project-card {
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-solid);
        transition:
            transform var(--transition-fast),
            border-color var(--transition-fast),
            box-shadow var(--transition-fast);

        &:hover {
            transform: translateY(-2px);
            box-shadow: 3px 3px 0px 0px var(--color-border-strong);
        }
    }

    .project-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3) var(--space-5);
        background-color: var(--color-surface-sunken);
        border-bottom: 1px solid var(--color-border-subtle);
    }

    .project-ident {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .project-serial {
        font-size: var(--text-xs);
        font-weight: 700;
        letter-spacing: 0.06em;
    }

    /* Screen Visual */
    .project-screen {
        height: 140px;
        background-color: var(--color-surface-elevated);
        border-bottom: 1px solid var(--color-border-subtle);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .screen-grid-bg {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--grid-line-color) 1px, transparent 1px),
            linear-gradient(90deg, var(--grid-line-color) 1px, transparent 1px);
        background-size: 16px 16px;
        opacity: 0.6;
    }

    .screen-icon {
        position: relative;
        z-index: 1;
        width: 44px;
        height: 44px;
        color: var(--color-text);
        transition: transform var(--transition-fast);

        svg {
            width: 100%;
            height: 100%;
        }
    }

    .screen-picture {
        display: contents;
    }

    .screen-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        display: block;
        transition: transform var(--transition-base);
    }

    .project-card:hover .screen-image {
        transform: scale(1.04);
    }

    .screen-indicator--badge {
        background-color: color-mix(in oklch, var(--color-surface-sunken) 85%, transparent);
        padding: 2px 6px;
        border-radius: var(--radius-xs);
        border: 1px solid var(--color-border);
        color: var(--color-text-muted);
    }

    .project-card:hover .screen-icon {
        transform: scale(1.1);
    }

    .screen-indicator {
        position: absolute;
        bottom: var(--space-2);
        right: var(--space-3);
        color: var(--color-text-subtle);
        letter-spacing: 0.08em;
    }

    /* Card Accents */
    .accent-cyan:hover {
        border-color: var(--color-cyan);
        .screen-icon {
            color: var(--color-cyan-text);
        }
    }
    .accent-phosphor:hover {
        border-color: var(--color-phosphor);
        .screen-icon {
            color: var(--color-phosphor-text);
        }
    }
    .accent-amber:hover {
        border-color: var(--color-amber);
        .screen-icon {
            color: var(--color-amber-text);
        }
    }
    .accent-coral:hover {
        border-color: var(--color-coral);
        .screen-icon {
            color: var(--color-coral-text);
        }
    }
    .accent-purple:hover {
        border-color: var(--color-purple);
        .screen-icon {
            color: var(--color-purple-text);
        }
    }

    /* Content */
    .project-content {
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        flex: 1;
    }

    .project-title {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-text);
    }

    .project-desc {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
        line-height: 1.55;
        flex: 1;
    }

    .project-tech-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        margin-top: var(--space-1);
    }

    .project-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-top: var(--space-2);
        padding-top: var(--space-3);
        border-top: 1px dashed var(--color-border-subtle);
    }

    .btn-sm {
        padding: var(--space-2) var(--space-3);
        font-size: var(--text-2xs);
    }

    .btn-icon {
        padding: var(--space-2);
        border-radius: var(--radius-xs);
    }

    .gh-icon {
        width: 18px;
        height: 18px;
    }

    /* Archive Callout */
    .archive-callout {
        margin-top: var(--space-12);
        padding: var(--space-6);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        box-shadow: var(--shadow-solid);

        @media (min-width: 640px) {
            flex-direction: row;
        }
    }
</style>
