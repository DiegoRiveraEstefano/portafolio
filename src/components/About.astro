---
import { getCollection } from "astro:content";

const profileList = await getCollection("profile");
const profile = profileList[0]?.data;
---

<section id="about" class="section about-section">
  <div class="container">
    <div class="section-header">
      <span class="section-index">01 // TELEMETRÍA &amp; PERFIL</span>
      <h2 class="section-title">Sobre Mí</h2>
      <p class="section-subtitle">
        Resolviendo problemas complejos mediante arquitecturas escalables, código eficiente y sistemas confiables.
      </p>
    </div>

    <div class="about-grid">
      <!-- Technical Bio Panel -->
      <div class="bio-panel specs-card corner-marks">
        <div class="panel-tag mono text-2xs text-amber">
          // SYS_MANIFESTO.md
        </div>
        <h3 class="bio-heading">
          {profile?.about.heading || "Ingeniería de backend enfocada en rendimiento, sistemas distribuidos y observabilidad"}
        </h3>
        <div class="bio-text">
          {
            profile?.about.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
        </div>

        <div class="bio-footer mono text-2xs text-muted">
          <span>PIPELINE: {profile?.about.pipeline || "DESIGN -> PROFILE -> OPTIMIZE -> SCALE"}</span>
        </div>
      </div>

      <!-- Telemetry Metrics Display -->
      <div class="telemetry-grid">
        {
          profile?.telemetry.map((metric) => (
            <div class="telemetry-card">
              <div class="meter-header">
                <span class="mono text-2xs text-muted">{metric.code}</span>
                <span class={`status-dot status-dot--${metric.statusDot}`}></span>
              </div>
              <div class={`meter-value mono ${metric.color}`}>{metric.value}</div>
              <div class="meter-label">{metric.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);

    @media (min-width: 992px) {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }
  }

  .bio-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .panel-tag {
    letter-spacing: 0.08em;
  }

  .bio-heading {
    font-size: clamp(var(--text-lg), 2vw, var(--text-2xl));
    color: var(--color-text);
    line-height: 1.3;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-base);

    p {
      color: var(--color-text-muted);
    }
  }

  .bio-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border-subtle);
  }

  /* Telemetry Grid */
  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-4);
  }

  .telemetry-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
    box-shadow: var(--shadow-solid);

    &:hover {
      border-color: var(--color-border-strong);
      transform: translateY(-2px);
    }
  }

  .meter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .meter-value {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: 700;
    line-height: 1;
    margin-block: var(--space-2);
  }

  .meter-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
</style>