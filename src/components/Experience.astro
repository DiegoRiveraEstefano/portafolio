---
import { getCollection } from "astro:content";

const experiencesList = await getCollection("experiences");
---

<section id="experience" class="section experience-section">
  <div class="container">
    <div class="section-header">
      <span class="section-index">02 // HISTORIAL DE SERVICIO &amp; PRODUCCIÓN</span>
      <h2 class="section-title">Experiencia Laboral</h2>
      <p class="section-subtitle">
        Panel interactivo de servicio técnico: haz clic en cualquier módulo para expandir los detalles de arquitectura y resultados en producción.
      </p>
    </div>

    <!-- Interactive Masonry Grid of Service Records -->
    <div id="experience-masonry-grid" class="masonry-grid" role="region" aria-label="Historial de experiencia interactivo">
      {
        experiencesList.map((exp, index) => {
          const serial = String(index + 1).padStart(2, "0");
          const isInitiallyExpanded = index === 0;

          return (
            <article
              class={`masonry-card specs-card corner-marks ${isInitiallyExpanded ? "is-expanded" : "is-collapsed"}`}
              data-card-id={exp.id}
              tabindex="0"
              role="button"
              aria-expanded={isInitiallyExpanded ? "true" : "false"}
              aria-label={`Ver detalles de experiencia en ${exp.data.company} como ${exp.data.role}`}
            >
              <!-- Card Header Bar -->
              <div class="card-bar">
                <div class="bar-left">
                  <span class="card-serial mono text-xs text-amber">[SRV_{serial}]</span>
                  <div class="status-indicator mono text-2xs">
                    <span class={`status-dot status-dot--${exp.data.current ? "green" : "amber"}`}></span>
                    <span class="status-txt">{exp.data.current ? "ACTIVE" : "COMPLETED"}</span>
                  </div>
                </div>

                <div class="bar-right mono text-2xs text-muted">
                  <span class="period-str">{exp.data.period}</span>
                  <span class="expand-prompt mono text-amber" aria-hidden="true">
                    {isInitiallyExpanded ? "[EXPANDED]" : "[EXPAND +]"}
                  </span>
                </div>
              </div>

              <!-- Compact Header Area (Visible always) -->
              <div class="card-identity">
                <h3 class="role-title">{exp.data.role}</h3>
                <div class="company-row">
                  <strong class="company-tag mono text-amber">{exp.data.company}</strong>
                  <span class="dot" aria-hidden="true">•</span>
                  <span class="mono text-xs text-muted">{exp.data.employmentType}</span>
                  <span class="dot" aria-hidden="true">•</span>
                  <span class="mono text-xs text-subtle">{exp.data.duration}</span>
                </div>
              </div>

              <!-- Collapsed Teaser Preview -->
              <div class="collapsed-teaser">
                <p class="teaser-text text-muted text-xs">
                  {exp.data.summary?.slice(0, 110)}...
                </p>
                <div class="teaser-footer mono text-2xs text-amber">
                  <span>HACER CLIC PARA EXPANDIR MÓDULO</span>
                  <span class="plus-icon">+</span>
                </div>
              </div>

              <!-- Expanded Detailed Content Area -->
              <div class="expanded-tray">
                {exp.data.summary && <p class="exp-summary">{exp.data.summary}</p>}

                {
                  exp.data.highlights && exp.data.highlights.length > 0 && (
                    <div class="highlights-container">
                      <span class="container-tag mono text-2xs text-muted">[RESPONSABILIDADES_Y_LOGROS]</span>
                      <ul class="highlights-list">
                        {exp.data.highlights.map((highlight) => (
                          <li class="highlight-item">
                            <span class="item-mark mono text-phosphor" aria-hidden="true">&gt;</span>
                            <span class="item-body">{highlight}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                }

                <!-- Technologies Badges -->
                <div class="exp-techs">
                  {exp.data.technologies.map((tech) => (
                    <span class="badge">{tech}</span>
                  ))}
                </div>

                <!-- Action Footer -->
                <div class="card-action-bar">
                  <a
                    href={`/experience/${exp.id}`}
                    class="btn btn-primary btn-sm detail-link"
                    tabindex="0"
                  >
                    <span>VER ESPECIFICACIÓN DETALLADA [MD]</span>
                    <span class="mono">→</span>
                  </a>
                  <span class="mono text-2xs text-muted">ID: {exp.id}</span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Career Archive Callout Panel -->
    <div class="archive-callout">
      <div class="archive-meta mono text-xs text-muted">
        <span>SERVICE_LOG: COMPLETE_CAREER_ARCHIVE</span>
      </div>
      <a href="/experience" class="btn btn-secondary">
        <span>VER HISTORIAL COMPLETO DE SERVICIOS ({experiencesList.length})</span>
        <span class="mono">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .masonry-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);

    @media (min-width: 992px) {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      min-height: 480px;
    }
  }

  .masonry-card {
    padding: 0;
    overflow: hidden;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-solid);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    outline: none;
    transition:
      flex 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      max-width 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);

    &:focus-visible {
      border-color: var(--color-amber);
      box-shadow: var(--shadow-solid-focus);
    }

    @media (min-width: 992px) {
      flex: 1;
      min-width: 220px;
    }

    /* State: Collapsed */
    &.is-collapsed {
      background-color: var(--color-surface);
      opacity: 0.88;

      &:hover {
        opacity: 1;
        border-color: var(--color-border-strong);
        background-color: var(--color-surface-elevated);
      }

      .expanded-tray {
        display: none;
      }

      .collapsed-teaser {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-5);
        background-color: var(--color-surface-sunken);
        margin: var(--space-3);
        border-radius: var(--radius-xs);
        border: 1px dashed var(--color-border);
      }
    }

    /* State: Expanded */
    &.is-expanded {
      opacity: 1;
      border-color: var(--color-border-strong);
      background-color: var(--color-surface);
      box-shadow: 4px 4px 0px 0px var(--color-border-strong);

      @media (min-width: 992px) {
        flex: 2.8;
      }

      .collapsed-teaser {
        display: none;
      }

      .expanded-tray {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-5) clamp(var(--space-5), 4vw, var(--space-8));
      }
    }
  }

  /* Header Bar */
  .card-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-surface-sunken);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .card-serial {
    font-weight: 700;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .bar-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .expand-prompt {
    font-size: var(--text-2xs);
    font-weight: 700;
  }

  /* Identity */
  .card-identity {
    padding: var(--space-5) clamp(var(--space-5), 4vw, var(--space-8)) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-title {
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }

  .company-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: 2px;
  }

  .company-tag {
    font-size: var(--text-sm);
  }

  .dot {
    color: var(--color-border-strong);
  }

  /* Collapsed Teaser */
  .collapsed-teaser {
    margin-top: auto;
  }

  .teaser-text {
    line-height: 1.5;
  }

  .teaser-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .plus-icon {
    font-size: var(--text-base);
    line-height: 1;
  }

  /* Expanded Tray */
  .expanded-tray {
    flex: 1;
  }

  .exp-summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .highlights-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
  }

  .container-tag {
    letter-spacing: 0.06em;
  }

  .highlights-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--color-text);
  }

  .item-mark {
    font-weight: 700;
  }

  .exp-techs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .card-action-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border-subtle);
  }

  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-2xs);
  }

  /* Archive Callout */
  .archive-callout {
    margin-top: var(--space-12);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    box-shadow: var(--shadow-solid);

    @media (min-width: 640px) {
      flex-direction: row;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".masonry-card");

  cards.forEach((card) => {
    // Manejo de clic en la tarjeta para alternar expansión
    card.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      // Si el clic fue en el botón de navegación al detalle, no bloquear la navegación
      if (target.closest(".detail-link")) {
        return;
      }

      const isAlreadyExpanded = card.classList.contains("is-expanded");
      if (isAlreadyExpanded) return; // Si ya está expandida, no hacer nada

      // Colapsar las demás y expandir esta
      cards.forEach((otherCard) => {
        otherCard.classList.remove("is-expanded");
        otherCard.classList.add("is-collapsed");
        otherCard.setAttribute("aria-expanded", "false");
        const prompt = otherCard.querySelector(".expand-prompt");
        if (prompt) prompt.textContent = "[EXPAND +]";
      });

      card.classList.remove("is-collapsed");
      card.classList.add("is-expanded");
      card.setAttribute("aria-expanded", "true");
      const prompt = card.querySelector(".expand-prompt");
      if (prompt) prompt.textContent = "[EXPANDED]";
    });

    // Accesibilidad con teclado (Enter / Space)
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        const target = e.target as HTMLElement;
        if (target.closest(".detail-link")) return;

        e.preventDefault();
        card.click();
      }
    });
  });
</script>
