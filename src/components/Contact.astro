---
import { getCollection } from "astro:content";

const socialsList = await getCollection("socials");
const profileList = await getCollection("profile");
const profile = profileList[0]?.data;

// Mapeo de iconos para cada tipo de canal
const portIcons: Record<string, string> = {
  email: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`,
  linkedin: `<svg fill="currentColor" viewBox="0 0 20 20"><path d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z"></path></svg>`,
  github: `<svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd"></path></svg>`,
};
---

<section id="contact" class="section contact-section">
  <div class="container">
    <div class="section-header">
      <span class="section-index">05 // CONEXIÓN DIRECTA &amp; I/O</span>
      <h2 class="section-title">Trabajemos Juntos</h2>
      <p class="section-subtitle">
        Canales abiertos para propuestas de ingeniería de backend, sistemas distribuidos, optimización de infraestructura o consultas técnicas.
      </p>
    </div>

    <!-- Communication Hub Terminal -->
    <div class="contact-terminal specs-card corner-marks">
      <div class="terminal-header">
        <div class="terminal-title mono text-xs">
          <span class="status-dot status-dot--green"></span>
          <span>COMMUNICATION_HUB // READY_FOR_INCOMING</span>
        </div>
        <span class="mono text-2xs text-muted">PROTOCOL: SECURE_DIRECT</span>
      </div>

      <div class="ports-grid">
        {
          socialsList.map((social) => (
            <a
              href={social.data.href}
              target={social.data.type !== "email" ? "_blank" : undefined}
              rel={social.data.type !== "email" ? "noopener noreferrer" : undefined}
              class="port-card"
            >
              <div class="port-socket">
                <span class={`port-pin mono text-2xs ${social.data.accent}`}>{social.data.port}</span>
                <div class="port-icon">
                  <Fragment set:html={portIcons[social.data.type] || portIcons.email} />
                </div>
              </div>
              <div class="port-meta">
                <span class="port-type mono text-xs text-muted">{social.data.channelType}</span>
                <h3 class="port-name">{social.data.label}</h3>
                <span class="port-val mono text-sm">{social.data.value}</span>
              </div>
              <div class="port-arrow mono">↗</div>
            </a>
          ))
        }
      </div>

      <!-- Telemetry Status Ribbon -->
      <div class="terminal-footer">
        <div class="geo-status mono text-2xs text-muted">
          <span class="status-dot status-dot--amber"></span>
          <span>GEOLOC: {profile?.location || "CHILE [UTC-3]"} // DISPONIBLE PARA OPORTUNIDADES REMOTAS O HÍBRIDAS</span>
        </div>
        <span class="mono text-2xs text-subtle">RESPONSE_TIME: &lt; 24H</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-terminal {
    padding: 0;
    overflow: hidden;
    box-shadow: var(--shadow-solid);
  }

  .terminal-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-surface-sunken);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
  }

  .ports-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--color-border);

    @media (min-width: 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .port-card {
    background-color: var(--color-surface);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    position: relative;
    transition: background-color var(--transition-fast);

    &:hover {
      background-color: var(--color-surface-elevated);

      .port-arrow {
        color: var(--color-amber-text);
        transform: translate(2px, -2px);
      }

      .port-val {
        color: var(--color-text);
      }
    }
  }

  .port-socket {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .port-icon {
    width: 36px;
    height: 36px;
    padding: 8px;
    background-color: var(--color-surface-sunken);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-text);

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .port-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .port-name {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .port-val {
    color: var(--color-text-muted);
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  .port-arrow {
    align-self: flex-end;
    font-size: var(--text-lg);
    color: var(--color-text-subtle);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .terminal-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-surface-sunken);
    border-top: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .geo-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>